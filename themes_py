/* ═══════════════════════════════════════════════════════════════ */
/* UNIVERSAL THEME VARIABLES                                        */
/* ═══════════════════════════════════════════════════════════════ */
body[data-theme]{
  background:var(--bg-base) !important;
  color:var(--text-primary) !important;
  font-family:var(--font-display) !important;
  transition:background .4s ease, color .4s ease;
}

body[data-theme]::before{
  background-image:
    linear-gradient(var(--grid-color) 1px, transparent 1px),
    linear-gradient(90deg, var(--grid-color) 1px, transparent 1px) !important;
  background-size:60px 60px, 60px 60px !important;
}

body[data-theme] .header{
  background:linear-gradient(180deg, var(--bg-surface) 0%, var(--bg-base) 100%) !important;
  border-bottom:3px solid var(--accent) !important;
  box-shadow:
    inset 0 2px 0 rgba(255,255,255,.1),
    inset 0 -4px 12px rgba(0,0,0,.7),
    0 12px 40px rgba(0,0,0,.7) !important;
}

body[data-theme] .header h1{
  color:var(--text-primary) !important;
  text-shadow:0 0 30px var(--accent-glow);
}

body[data-theme] .header p{
  color:var(--accent) !important;
  font-family:var(--font-mono) !important;
}

body[data-theme] .card,
body[data-theme] .tile,
body[data-theme] .stat-card{
  background:linear-gradient(180deg, var(--bg-surface) 0%, var(--bg-elevated) 100%) !important;
  border:1px solid var(--border) !important;
  box-shadow:var(--shadow), inset 0 1px 0 var(--border-subtle) !important;
  color:var(--text-primary) !important;
}

body[data-theme] .card h3,
body[data-theme] .panel-title{
  color:var(--accent) !important;
}

body[data-theme] .panel-title{
  border-image:linear-gradient(90deg, var(--accent) 0%, transparent 60%) 1 !important;
}

body[data-theme] .panel-title::before{
  color:var(--accent);
  text-shadow:0 0 12px var(--accent);
}

body[data-theme] .panel-title::after{
  background:repeating-linear-gradient(90deg,
    var(--accent) 0px, var(--accent) 6px,
    transparent 6px, transparent 12px) !important;
}

body[data-theme] .btn{
  background:linear-gradient(180deg, var(--bg-hover) 0%, var(--bg-surface) 100%) !important;
  border:1px solid var(--border) !important;
  color:var(--text-primary) !important;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.15),
    inset 0 -2px 6px rgba(0,0,0,.5),
    0 6px 16px rgba(0,0,0,.5) !important;
}

body[data-theme] .btn.btn-success,
body[data-theme] .btn[onclick*="Save"]{
  background:linear-gradient(180deg, var(--success) 0%, color-mix(in srgb, var(--success) 70%, black) 100%) !important;
  color:var(--bg-base) !important;
}

body[data-theme] .bottom-nav{
  background:linear-gradient(180deg, var(--bg-surface) 0%, var(--bg-base) 100%) !important;
  box-shadow:0 -12px 40px rgba(0,0,0,.8), inset 0 2px 0 var(--border-subtle) !important;
}

body[data-theme] .bottom-nav::before{
  background:repeating-linear-gradient(45deg,
    var(--accent) 0px, var(--accent) 8px,
    transparent 8px, transparent 16px) !important;
  opacity:.4 !important;
}

body[data-theme] .bnav-item.active{
  background:color-mix(in srgb, var(--accent) 15%, transparent) !important;
  border-color:var(--accent) !important;
  box-shadow:
    inset 0 1px 0 var(--border-subtle),
    0 0 24px var(--accent-glow) !important;
}

body[data-theme] .bnav-item.active .bnav-label{
  color:var(--accent) !important;
}

body[data-theme] .bnav-item.active .bnav-icon{
  filter:drop-shadow(0 0 8px var(--accent-glow)) !important;
}

body[data-theme] .form-input,
body[data-theme] input,
body[data-theme] textarea,
body[data-theme] select{
  background:var(--bg-base) !important;
  border:1px solid var(--border) !important;
  color:var(--text-primary) !important;
  box-shadow:inset 0 3px 6px rgba(0,0,0,.6) !important;
  font-family:var(--font-mono) !important;
}

body[data-theme] .form-input:focus,
body[data-theme] input:focus,
body[data-theme] textarea:focus,
body[data-theme] select:focus{
  border-color:var(--accent) !important;
  box-shadow:
    inset 0 3px 6px rgba(0,0,0,.6),
    0 0 0 2px var(--accent-glow),
    0 0 30px var(--accent-glow) !important;
}

body[data-theme] .cat-card{
  border:1px solid var(--border) !important;
}

body[data-theme] .tile-accent{
  box-shadow:0 0 16px currentColor !important;
}

body[data-theme] .badge.ok,
body[data-theme] .badge.completed,
body[data-theme] .badge.paid{
