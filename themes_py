  color:var(--bg-base) !important;
}

body[data-theme] .badge.high,
body[data-theme] .badge.critical,
body[data-theme] .badge.warn{
  background:linear-gradient(180deg, var(--danger), color-mix(in srgb, var(--danger) 70%, black)) !important;
  color:#fff !important;
}

body[data-theme] .chat-box{
  background:var(--bg-base) !important;
  border:1px solid var(--border) !important;
  font-family:var(--font-mono) !important;
}

body[data-theme] .msg.ai{
  background:var(--bg-surface) !important;
  border-left:4px solid var(--success) !important;
  color:var(--text-primary) !important;
}

body[data-theme] .msg.user{
  background:linear-gradient(180deg, var(--accent) 0%, color-mix(in srgb, var(--accent) 60%, black) 100%) !important;
  color:var(--bg-base) !important;
}

body[data-theme] .stat-card .num{
  color:var(--accent) !important;
  text-shadow:0 0 24px var(--accent-glow);
  font-family:var(--font-mono) !important;
}

body[data-theme] .stat-card .lbl{
  color:var(--text-secondary) !important;
  font-family:var(--font-mono) !important;
}

body[data-theme] .card::before,
body[data-theme] .card::after{
  background:radial-gradient(circle at 30% 30%,
    var(--border) 0%, var(--bg-surface) 40%, var(--bg-base) 100%) !important;
}

/* ═══════════════════════════════════════════════════════════════ */
/* THEME PICKER                                                     */
/* ═══════════════════════════════════════════════════════════════ */
#themePicker{
  position:fixed;
  bottom:0;left:0;right:0;
  background:linear-gradient(180deg, var(--bg-surface,#1e242f) 0%, var(--bg-base,#080a0e) 100%);
  border-top:3px solid var(--accent,#ff6b1a);
  border-radius:20px 20px 0 0;
  padding:24px 20px 32px;
  z-index:99999;
  transform:translateY(100%);
  transition:transform .35s cubic-bezier(.16,1,.3,1);
  max-height:70vh;
  overflow-y:auto;
  box-shadow:0 -20px 60px rgba(0,0,0,.8);
}
#themePicker.open{transform:translateY(0);}
#themePickerBackdrop{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.6);
  backdrop-filter:blur(4px);
  z-index:99998;
  opacity:0;
  pointer-events:none;
  transition:opacity .3s ease;
}
#themePickerBackdrop.open{
  opacity:1;
  pointer-events:auto;
}
#themePicker::before{
  content:'';
  display:block;
  width:40px;height:4px;
  background:var(--border,#4a5568);
  border-radius:2px;
  margin:0 auto 16px;
}
#themePicker h3{
  font-size:13px;
  text-transform:uppercase;
  letter-spacing:.15em;
  color:var(--accent,#ff6b1a);
  margin-bottom:16px;
  text-align:center;
  font-family:var(--font-mono,monospace);
}
#themeGrid{
  display:grid;
  grid-template-columns:repeat(auto-fill, minmax(140px, 1fr));
  gap:12px;
  max-width:640px;
  margin:0 auto;
}
.themeOption{
  background:linear-gradient(135deg, var(--opt-bg-2) 0%, var(--opt-bg-1) 100%);
  border:2px solid var(--opt-border);
  border-radius:12px;
  padding:14px 12px;
  cursor:pointer;
  transition:all .2s ease;
  position:relative;
  overflow:hidden;
  text-align:left;
}
.themeOption:hover{
  transform:translateY(-2px);
  box-shadow:0 12px 32px rgba(0,0,0,.5);
}
.themeOption.active{
  border-color:var(--opt-accent);
  box-shadow:
    0 0 0 3px color-mix(in srgb, var(--opt-accent) 30%, transparent),
    0 12px 32px rgba(0,0,0,.5);
}
.themeOption.active::after{
  content:'✓';
  position:absolute;
  top:8px;right:8px;
  width:22px;height:22px;
  background:var(--opt-accent);
  color:var(--opt-bg-1);
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:900;
  font-size:13px;
  box-shadow:0 0 12px var(--opt-accent);
}
.themeSwatch{
  display:flex;
  gap:4px;
  margin-bottom:10px;
}
.themeSwatch span{
  width:20px;height:20px;
  border-radius:50%;
  border:1px solid rgba(255,255,255,.15);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.2);
}
.themeName{
  font-size:13px;
  font-weight:800;
  color:var(--opt-text);
  margin-bottom:2px;
  letter-spacing:.02em;
}
.themeDesc{
  font-size:10px;
  color:var(--opt-muted);
  font-family:var(--font-mono,monospace);
  text-transform:uppercase;
  letter-spacing:.05em;
}

#themeFab{
  position:fixed;
  top:14px;
  right:14px;
  width:42px;height:42px;
  border-radius:50%;
  background:linear-gradient(180deg, #2a3141 0%, #080a0e 100%);
  border:1px solid #4a5568;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.15),
    0 4px 12px rgba(0,0,0,.6);
  color:#ff9f1c;
  cursor:pointer;
  z-index:9999;
  display:flex;
  align-items:center;
  justify-content:center;
  transition:transform .2s ease;
  font-size:22px;
  padding:0;
}
#themeFab:active{transform:scale(.9) rotate(45deg);}
#themeFab svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:2.2;}
</style>

