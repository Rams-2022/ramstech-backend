<!-- Backdrop -->
<div id="themePickerBackdrop" onclick="closeThemePicker()"></div>

<!-- Theme picker -->
<div id="themePicker">
  <h3>Choose Your Theme</h3>
  <div id="themeGrid"></div>
</div>

<script>
var _themes = [
  {id:'workshop', name:'Workshop', desc:'Industrial', colors:['#ff6b1a','#00e676','#0a0c10'], accent:'#ff6b1a'},
  {id:'midnight', name:'Midnight', desc:'Deep blue', colors:['#3b82f6','#22d3a6','#05080f'], accent:'#3b82f6'},
  {id:'carbon',   name:'Carbon',   desc:'Racing', colors:['#e60000','#00d26a','#0a0a0a'], accent:'#e60000'},
  {id:'neon',     name:'Neon',     desc:'Cyberpunk', colors:['#ff00ff','#00ffff','#0a0014'], accent:'#ff00ff'},
  {id:'vintage',  name:'Vintage',  desc:'Retro', colors:['#d97706','#f5e6d3','#1a1410'], accent:'#d97706'},
  {id:'light',    name:'Daylight', desc:'Clean', colors:['#ea580c','#ffffff','#f1f5f9'], accent:'#ea580c'},
  {id:'racing',   name:'Racing',   desc:'Motorsport', colors:['#ffcc00','#ff0000','#0d0d0d'], accent:'#ffcc00'},
  {id:'sahara',   name:'Sahara',   desc:'Warm earth', colors:['#ea9a3e','#9caf3e','#1a1410'], accent:'#ea9a3e'},
  {id:'matrix',   name:'Matrix',   desc:'Terminal', colors:['#00ff00','#00ccff','#000000'], accent:'#00ff00'}
];

function buildThemeGrid(){
  var current = document.body.getAttribute('data-theme') || 'workshop';
  var grid = document.getElementById('themeGrid');
  var h = '';
  _themes.forEach(function(t){
    var active = t.id === current ? 'active' : '';
    h += '<div class="themeOption ' + active + '" onclick="pickTheme(\'' + t.id + '\')" ';
    h += 'style="';
    h += '--opt-bg-1:' + t.colors[2] + ';';
    h += '--opt-bg-2:' + t.colors[0] + '20;';
    h += '--opt-border:' + t.colors[0] + '40;';
    h += '--opt-accent:' + t.accent + ';';
    h += '--opt-text:' + (t.id === 'light' ? '#0f172a' : '#f0f0f0') + ';';
    h += '--opt-muted:' + t.colors[0] + ';';
    h += '">';
    h += '<div class="themeSwatch">';
    t.colors.forEach(function(c){
      h += '<span style="background:' + c + ';"></span>';
    });
    h += '</div>';
    h += '<div class="themeName">' + t.name + '</div>';
    h += '<div class="themeDesc">' + t.desc + '</div>';
    h += '</div>';
  });
  grid.innerHTML = h;
}

function openThemePicker(){
  buildThemeGrid();
  document.getElementById('themePicker').classList.add('open');
  document.getElementById('themePickerBackdrop').classList.add('open');
}

function closeThemePicker(){
  document.getElementById('themePicker').classList.remove('open');
  document.getElementById('themePickerBackdrop').classList.remove('open');
}

function pickTheme(id){
  document.body.setAttribute('data-theme', id);
  try{ localStorage.setItem('ramstech_theme', id); }catch(e){}
  buildThemeGrid();
  if(window.dpToast) dpToast('Theme: ' + id, 'success');
  setTimeout(closeThemePicker, 400);
}

// Restore saved theme
(function(){
  try{
    var saved = localStorage.getItem('ramstech_theme') || 'workshop';
    document.body.setAttribute('data-theme', saved);
  }catch(e){
    document.body.setAttribute('data-theme', 'workshop');
  }
})();
</script>
